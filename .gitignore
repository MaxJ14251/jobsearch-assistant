.venv/
# Local agent tooling (downloaded skills) — not part of the product.
# NOTE: .gitignore has no trailing-comment syntax; a comment on the same
# line becomes part of the pattern and silently matches nothing.
.claude/
__pycache__/
*.pyc

# Coverage artifacts. .coverage is a binary SQLite file that embeds the
# ABSOLUTE PATH of every measured source file -- on Windows that includes
# C:\Users\<your-account>\... . It was committed once and went unnoticed,
# because an OS account name is not a value the profile knows about.
# .coveragerc is plain config and stays tracked.
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- personal data: never commit -------------------------------------------
# Your filled-in profile holds your name, home address, phone and email.
# Commit profile/master_profile.example.yaml instead.
profile/master_profile.yaml

# `jsa import-resume` writes a draft profile next to it (real contact details),
# and profile/ is where a resume is likely to be dropped.
profile/*.draft.yaml
profile/*.docx
profile/*.pdf

# API keys.
.env

# The tracker holds your real application history, and so do its copies
# (`jsa backup`).
*.db
backups/
*.db-wal
*.db-shm

# Generated resumes and cover letters contain your contact details.
output/
documents/

*.log
# `jsa daily` logs, beside the tracker.
logs/

# Packaging (plan 27): what `pip wheel .` leaves behind.
build/
dist/
*.egg-info/
