# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must never be committed or shared.

# NVIDIA NIM API key, from https://build.nvidia.com (log in, open any model,
# then "Generate API Key"). Used by jsa/llm.py for tailoring and interview prep.
NVIDIA_API_KEY=<paste-your-nvapi-key-here>

# Optional — point at a different OpenAI-compatible endpoint.
# JSA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional — override the tracker database location.
# JSA_DB=jobsearch.db

# Optional but strongly recommended — The Muse API key, free, from
# https://www.themuse.com/developers/api/v2/apps (register an app; their terms
# require it for anything beyond testing). This is the ONE source that is not
# a single employer's board: it covers many employers in your own cities, and
# without it a newcomer outside a few tech metros gets remote roles only.
# Discovery skips that source when this is unset; everything else still runs.
MUSE_API_KEY=

# Optional — read replies to your applications from Gmail, READ-ONLY
# (`jsa inbox`; ADR 0021). The tool opens the mailbox read-only, marks
# nothing as read, never sends, and only suggests stage changes for you to
# confirm. Use a Gmail APP PASSWORD, never your account password: it is a
# separate 16-letter code you can revoke at any time. Create one at Google
# Account > Security > 2-Step Verification > App passwords (needs 2-Step
# Verification; not available on work/school or Advanced Protection accounts).
JSA_IMAP_USER=
JSA_IMAP_APP_PASSWORD=
# JSA_IMAP_HOST=imap.gmail.com
# JSA_IMAP_FOLDER=[Gmail]/All Mail

# Optional: model prices per million tokens, for `jsa usage`'s estimated cost.
# Leave empty to see counts only.
JSA_PRICE_IN_PER_MTOK=
JSA_PRICE_OUT_PER_MTOK=
