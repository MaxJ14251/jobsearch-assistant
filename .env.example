# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must never be committed or shared.

# NVIDIA NIM API key, from https://build.nvidia.com (log in, open any model,
# then "Generate API Key"). Used by jsa/llm.py for tailoring and interview prep.
NVIDIA_API_KEY=<paste-your-nvapi-key-here>

# Optional — point at a different OpenAI-compatible endpoint.
# JSA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional — override the tracker database location.
# JSA_DB=jobsearch.db
